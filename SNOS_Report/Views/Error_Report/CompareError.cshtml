
@{
    ViewBag.Title = "CompareError";
    List<SNOS_Report.Database.Mac_Spec> lineinfor = ViewBag.linelist;
    string linename = "";
}

<main class="content">
    <div class="container-fluid p-0">
        <div class="mb-3">
            <h1 class="h3 d-inline align-middle">CompareData Monthly</h1>
        </div>
        <div class="card">
            <div class="card-header pb-0">
                <div class="row">
                    <div class="mb-3 col-md-2">
                        <label class="form-label">SelectChart</label>
                        <select id="SelectChart" class="form-select" onchange="selectChart($(this).val())">
                            <option value="Monthly">Monthly</option>
                            <option value="Yearly">Yearly</option>
                        </select>
                    </div>
                    <div class="mb-3 col-md-3" id="divMonth">
                        <label class="form-label">Month</label>
                        <select id="month" class="form-select">
                            <option value="1">January</option>
                            <option value="2">February</option>
                            <option value="3">March</option>
                            <option value="4">April</option>
                            <option value="5">May</option>
                            <option value="6">June</option>
                            <option value="7">July</option>
                            <option value="8">August</option>
                            <option value="9">September</option>
                            <option value="10">October</option>
                            <option value="11">November</option>
                            <option value="12">December</option>
                        </select>
                    </div>
                    <div class="mb-3 col-md-3">
                        <label class="form-label">Year</label>
                        <input type="number" id="year" class="form-control" min="2000" max="2100" value="2024">
                    </div>
                    <div class="mb-3 col-md-2">
                        <label class="form-label">Line</label>
                        <select class="form-select" aria-label="Default select example" id="line" onchange="changeline()">
                            @{
                                int ct = 1;
                                foreach (var x in lineinfor)
                                {
                                    if (x.Line_No == ViewBag.Line)
                                    {
                                        <option selected value="@x.Line_No">@x.Line_Name</option>
                                        linename = x.Line_Name;

                                    }
                                    else
                                    {
                                        <option value="@x.Line_No">@x.Line_Name</option>

                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3 col-md-2 d-flex align-items-end">
                        <button id="showChart" class="btn btn-primary w-100" onclick="searchclick();">Show Chart</button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div id="myChart"></div>
                <table class="table table-bordered mt-3">
                    <thead>
                        <tr>
                            <th>Error No.</th>
                            <th>Title</th>
                        </tr>
                    </thead>
                    <tbody id="errorTableBody"></tbody>
                </table>

            </div>
        </div>
    </div>
</main>

<script>
    $(document).ready(function () {
    // เซ็ตค่าถ้ายังไม่มีค่าใน sessionStorage
    if (!sessionStorage.getItem("selectChart")) {
        sessionStorage.setItem("selectChart", "Monthly");
    }

    // โหลดค่าจาก sessionStorage
    $("#SelectChart").val(sessionStorage.getItem("selectChart"));
    selectChart($("#SelectChart").val()); // ตรวจสอบค่า dropdown

    if (sessionStorage.getItem("selectedMonth")) {
        $("#month").val(sessionStorage.getItem("selectedMonth"));
    }
    if (sessionStorage.getItem("selectedYear")) {
        $("#year").val(sessionStorage.getItem("selectedYear"));
    }

    loadChart();
});

    function selectChart(value) {
        sessionStorage.setItem("selectChart", value);
        if (value == "Yearly") {
            $("#divMonth").hide();
        } else {
            $("#divMonth").show();
        }
    }

    $("#month, #year").change(function () {
        sessionStorage.setItem("selectedMonth", $("#month").val());
        sessionStorage.setItem("selectedYear", $("#year").val());
    });

    function loadChart() {
        var rawData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Errordata)) || [];
        var _lastCounts = [];
        var _thisCounts = [];
        var maxLastCount = Math.max(...rawData.map(data => data.Last_Count));
        var maxThisCount = Math.max(...rawData.map(data => data.This_Count));
        var maxCount = Math.max(maxLastCount, maxThisCount);

        rawData.forEach(item => {
            var _lastCount = item.Last_Count;
            var _thisCount = item.This_Count;

            var percentage_lastCount = (_lastCount / maxCount) * 100;
            var roundedPercentage_lastCount = roundToNearest5(percentage_lastCount);
            var percentage_thisCount = (_thisCount / maxCount) * 100;
            var roundedPercentage_thisCount = roundToNearest5(percentage_thisCount);

            _lastCounts.push(roundedPercentage_lastCount);  // เก็บค่า Last_Count
            _thisCounts.push(roundedPercentage_thisCount);  // เก็บค่า This_Count ที่ปัดลงตัว 5
        });

        if (!Array.isArray(rawData) || rawData.length === 0) {
            console.error("Error: No data found in ViewBag.Errordata");
            return;
        }

        var categories = rawData.map(item => item.Error_No);
        var lastCounts = rawData.map(item => item.Last_Count);
        var thisCounts = rawData.map(item => item.This_Count);


        var options = {
            series: [
                { name: 'Last Count', data: _lastCounts },
                { name: 'This Count', data: _thisCounts }
            ],
            chart: { type: 'bar', height: 350 },
            plotOptions: {
                bar: {
                    horizontal: false,
                    columnWidth: '50%',
                    dataLabels: {
                        position: 'top'
                    }
                }
            },
            xaxis: {
                categories: categories,
                labels: {
                    //rotate: 0,
                    //trim: true,
                    style: {
                        colors: 'black',
                        fontWeight: 'bold',
                        background: 'black'
                    }
                }
                //labels: {
                //    formatter: function (value) {
                //        var item = rawData.find(data => data.Title === value);
                //        return [item.Last_Count.toString() + " " + item.This_Count.toString(), value];
                //    }
                //}
            },
            yaxis: {
                show: false,
                max: 100
            },
            dataLabels: {
                formatter: function (val, opt) {
                    var category = opt.w.config.xaxis.categories[opt.dataPointIndex];
                    var seriesIndex = opt.seriesIndex;
                    var item = rawData.find(data => data.Error_No === category);
                    return (seriesIndex == 0 ? item.Last_Count : item.This_Count);
                },
                style: {
                    colors: ['#000000'],
                    fontSize: '20px'
                },
                offsetY: 0
            },
            title: { text: 'Error Comparison: Last Count vs This Count' },
            tooltip: {
                enabled: false
            }
        };

        window.myChart = new ApexCharts($("#myChart")[0], options);
        window.myChart.render();
        loadTable(rawData);
    }
    function loadTable(data) {
        var tableBody = document.getElementById("errorTableBody");
        tableBody.innerHTML = "";  // ล้างข้อมูลเก่า

        data.forEach(item => {
            var row = `<tr>
            <td>${item.Error_No}</td>
            <td>${item.Title}</td>
        </tr>`;
            tableBody.innerHTML += row;
        });
    }



    function roundToNearest5(value) {
        return Math.ceil(value / 5) * 5;
    }

function searchclick() {
    var SelectChart = document.getElementById("SelectChart").value;
    var month = document.getElementById("month").value;
    var year = document.getElementById("year").value;
    var line = document.getElementById("line").value;

    var url = "../Error_Report/CompareError";
    url += "?month=" + encodeURIComponent(month);
    url += "&year=" + encodeURIComponent(year);
    url += "&line=" + encodeURIComponent(line);
    url += "&SelectChart=" + encodeURIComponent(SelectChart);

    window.location.replace(url);
}

</script>



