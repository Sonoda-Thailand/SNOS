
@{
    ViewBag.Title = "CompareError";
    List<SNOS_Report.Database.Mac_Spec> lineinfor = ViewBag.linelist;
    string linename = "";
}

<main class="content">
    <div class="container-fluid p-0">
        <div class="mb-3">
            <h1 class="h3 d-inline align-middle">CompareData Monthly</h1>
        </div>
        <div class="card">
            <div class="card-header pb-0">
                <div class="row">
                    <div class="mb-3 col-md-2">
                        <label class="form-label">SelectChart</label>
                        <select id="SelectChart" class="form-select" onchange="selectChart($(this).val())">
                            <option value="Monthly">Monthly</option>
                            <option value="Yearly">Yearly</option>
                        </select>
                    </div>
                    <div class="mb-3 col-md-3" id="divMonth">
                        <label class="form-label">Month</label>
                        <select id="month" class="form-select">
                            <option value="1">January</option>
                            <option value="2">February</option>
                            <option value="3">March</option>
                            <option value="4">April</option>
                            <option value="5">May</option>
                            <option value="6">June</option>
                            <option value="7">July</option>
                            <option value="8">August</option>
                            <option value="9">September</option>
                            <option value="10">October</option>
                            <option value="11">November</option>
                            <option value="12">December</option>
                        </select>
                    </div>
                    <div class="mb-3 col-md-3">
                        <label class="form-label">Year</label>
                        <input type="number" id="year" class="form-control" min="2000" max="2100" value="2024">
                    </div>
                    <div class="mb-3 col-md-2">
                        <label class="form-label">Line</label>
                        <select class="form-select" aria-label="Default select example" id="line" onchange="changeline()">
                            @{
                                int ct = 1;
                                foreach (var x in lineinfor)
                                {
                                    if (x.Line_No == ViewBag.Line)
                                    {
                                        <option selected value="@x.Line_No">@x.Line_Name</option>
                                        linename = x.Line_Name;

                                    }
                                    else
                                    {
                                        <option value="@x.Line_No">@x.Line_Name</option>

                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3 col-md-2 d-flex align-items-end">
                        <button id="showChart" class="btn btn-primary w-100" onclick="searchclick();">Show Chart</button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div id="myChart"></div>
                <table class="table table-bordered mt-3">
                    <thead>
                        <tr>
                            <th>Error No.</th>
                            <th>Title</th>
                            <th width="50%">Description</th>
                        </tr>
                    </thead>
                    <tbody id="errorTableBody"></tbody>
                </table>

            </div>
        </div>
    </div>
</main>

<script>
    $(document).ready(function () {
    // เซ็ตค่าถ้ายังไม่มีค่าใน sessionStorage
    if (!sessionStorage.getItem("selectChart")) {
        sessionStorage.setItem("selectChart", "Monthly");
    }

    // โหลดค่าจาก sessionStorage
    $("#SelectChart").val(sessionStorage.getItem("selectChart"));
    selectChart($("#SelectChart").val()); // ตรวจสอบค่า dropdown

    if (sessionStorage.getItem("selectedMonth")) {
        $("#month").val(sessionStorage.getItem("selectedMonth"));
    }
    if (sessionStorage.getItem("selectedYear")) {
        $("#year").val(sessionStorage.getItem("selectedYear"));
    }

    loadChart();
});

    function selectChart(value) {
        sessionStorage.setItem("selectChart", value);
        if (value == "Yearly") {
            $("#divMonth").hide();
        } else {
            $("#divMonth").show();
        }
    }

    $("#month, #year").change(function () {
        sessionStorage.setItem("selectedMonth", $("#month").val());
        sessionStorage.setItem("selectedYear", $("#year").val());
    });

function loadChart() {
    var rawData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Errordata)) || [];
    var isYearly = sessionStorage.getItem("selectChart") === "Yearly";

    if (!Array.isArray(rawData) || rawData.length === 0) {
        console.error("Error: No data found");
        return;
    }

    // ✅ เคส Yearly: มี Month + Error_No → แสดงเป็นหลายแท่งแยกสีตามเดือน
    if (
        isYearly &&
        rawData.length > 0 &&
        rawData[0].hasOwnProperty("Month") &&
        rawData[0].hasOwnProperty("Error_No")
    )
    {
        const monthLabels = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

        const errorTypes = [...new Set(rawData.map(item => item.Error_No))];

        const series = errorTypes.map(errorNo => {
            const monthlyCounts = new Array(12).fill(0);
            rawData
                .filter(x => x.Error_No === errorNo)
                .forEach(x => {
                    const idx = x.Month - 1;
                    monthlyCounts[idx] = x.Count || 0;
                });

            return {
                name: `Error ${errorNo}`,
                data: monthlyCounts
            };
        });

        const options = {
            series: series,
            chart: {
                type: 'bar',
                height: 400,
                stacked: false
            },
            plotOptions: {
                bar: {
                    horizontal: false,
                    columnWidth: '60%'
                }
            },
            xaxis: {
                categories: monthLabels,
                labels: {
                    style: { fontWeight: 'bold' }
                }
            },
            yaxis: {
                title: { text: "Error Count" }
            },
            dataLabels: {
                enabled: false
            },
            title: {
                text: 'Yearly Error Breakdown by Month'
            },
            legend: {
                position: 'top'
            },
            tooltip: {
                shared: true,
                intersect: false  // ✅ เพิ่มบรรทัดนี้
            }
        };

        $("#myChart").empty();
        window.myChart = new ApexCharts($("#myChart")[0], options);
        window.myChart.render();
        $("#errorTableBody").html("");
        loadTable(rawData);  // <-- เพิ่มตรงนี้หลัง render chart (Yearly)

        return;
    }

    // ✅ เคส Monthly: เปรียบเทียบ Last/This Count
    var filteredData = rawData.filter(item => item.Last_Count !== 0 || item.This_Count !== 0);

    var _lastCounts = [];
    var _thisCounts = [];

    var maxLastCount = Math.max(...filteredData.map(data => data.Last_Count));
    var maxThisCount = Math.max(...filteredData.map(data => data.This_Count));
    var maxCount = Math.max(maxLastCount, maxThisCount);

    filteredData.forEach(item => {
        var _lastCount = item.Last_Count;
        var _thisCount = item.This_Count;

        var percentage_lastCount = (_lastCount / maxCount) * 100;
        var percentage_thisCount = (_thisCount / maxCount) * 100;

        _lastCounts.push(roundToNearest5(percentage_lastCount));
        _thisCounts.push(roundToNearest5(percentage_thisCount));
    });

    var categories = filteredData.map(item => `Error No. ${item.Error_No}`);

    var seriesData = [
        { name: 'Last Count', data: _lastCounts },
        { name: 'This Count', data: _thisCounts }
    ];

    var options = {
        series: seriesData,
        chart: { type: 'bar', height: 350 },
        plotOptions: {
            bar: {
                horizontal: false,
                columnWidth: '50%',
                dataLabels: { position: 'top' }
            }
        },
        xaxis: {
            categories: categories,
            labels: {
                style: { colors: 'black', fontWeight: 'bold' }
            }
        },
        yaxis: {
            show: false,
            max: 100
        },
        dataLabels: {
            formatter: function (val, opt) {
                var category = opt.w.config.xaxis.categories[opt.dataPointIndex];
                var item = filteredData.find(data => `Error No. ${data.Error_No}` === category);
                if (!item) return "";
                return opt.seriesIndex === 0 ? item.Last_Count : item.This_Count;
            },
            style: { colors: ['#000000'], fontSize: '20px' },
            offsetY: 0
        },
        title: { text: 'Monthly Error Comparison' },
        tooltip: { enabled: false }
    };

    $("#myChart").empty();
    window.myChart = new ApexCharts($("#myChart")[0], options);
    window.myChart.render();
    loadTable(filteredData);
}


    function loadTable(data) {
        var tableBody = document.getElementById("errorTableBody");
        tableBody.innerHTML = ""; // ล้างข้อมูลเก่า

        if (!Array.isArray(data) || data.length === 0) {
            tableBody.innerHTML = `<tr><td colspan="3" class="text-center text-muted">No error data found</td></tr>`;
            return;
        }

        // 👉 สร้างรายการ error สรุป (ใช้ Error_No + Title เป็น key)
        const grouped = {};

        data.forEach(item => {
            const key = item.Error_No + "|" + (item.Title || "");
            if (!grouped[key]) {
                grouped[key] = {
                    Error_No: item.Error_No,
                    Title: item.Title,
                    Count: 0
                };
            }
            grouped[key].Count += item.Count || 0;
        });

        // 👉 แปลงกลับเป็น array เพื่อ render
        const rows = Object.values(grouped);

        rows.forEach(item => {
            var row = `<tr>
            <td>${item.Error_No}</td>
            <td>${item.Title || '-'}</td>
            <td></td>
        </tr>`;
            tableBody.innerHTML += row;
        });
    }





    function roundToNearest5(value) {
        return Math.ceil(value / 5) * 5;
    }

function searchclick() {
    var SelectChart = document.getElementById("SelectChart").value;
    var month = document.getElementById("month").value;
    var year = document.getElementById("year").value;
    var line = document.getElementById("line").value;

    var url = "../Error_Report/CompareError";
    url += "?month=" + encodeURIComponent(month);
    url += "&year=" + encodeURIComponent(year);
    url += "&line=" + encodeURIComponent(line);
    url += "&SelectChart=" + encodeURIComponent(SelectChart);

    window.location.replace(url);
}

</script>



